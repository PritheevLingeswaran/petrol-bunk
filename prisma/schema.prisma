// =============================================================================
// Petrol Bunk Management System — full schema for all 7 phases.
// Read PROJECT_SPEC.md before changing anything here.
//
// Conventions enforced in this file:
//   * Decimal for every money / litre / rate / density / percent value.
//       amounts   Decimal(18,2)    litres  Decimal(16,2)    rates Decimal(12,2)
//       avg cost  Decimal(14,4)    density Decimal(6,1)     pct   Decimal(7,4)
//   * Every transactional model carries outletId and is indexed on
//     (outletId, <business date>).
//   * Business dates are @db.Date (a shift belongs to a date, not a moment).
//     Everything else is UTC DateTime, displayed in Asia/Kolkata.
//   * No hard deletes on transactional models — status / isCancelled only.
//   * Balances are never stored. They are derived from voucher_lines.
//   * createdById / updatedById / cancelledById are user ids stored as plain
//     scalars (no FK) on high-volume tables, to avoid ~40 back-relations on
//     User. Integrity for these is carried by audit_logs, which does have the
//     FK. Approval and ownership relations that drive logic ARE real FKs.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

